# Copier en `.env` (ignoré par Git). Aucun secret ici : les secrets vont dans deploiement/secrets/.

# claude = CLI réel (abonnement) ; api = clé API Anthropic ; openai = tout fournisseur compatible OpenAI
# (OpenRouter, OpenAI, Mistral, serveur local…) ; factice = démonstration
AC_MOTEUR=claude
# Moteur pris automatiquement quand le principal signale un crédit épuisé (vide = aucun).
# Avec `api`, déposer la clé dans secrets/anthropic_api_key ; avec `openai`, dans secrets/openai_api_key.
AC_MOTEUR_SECOURS=

# Moteur « openai » : URL de base et modèles du fournisseur (OpenRouter par défaut).
# Modèles : `nom affiché=identifiant` ou identifiant seul, séparés par des virgules ; le premier sert de défaut.
# Si ce moteur est en secours du CLI, nommer les entrées sonnet, opus et haiku.
#AC_OPENAI_URL=https://openrouter.ai/api/v1
#AC_OPENAI_MODELES=sonnet=anthropic/claude-sonnet-4.5,haiku=google/gemini-2.5-flash,openai/gpt-5
# Tarifs en $ par million de jetons (entrée/sortie), pour estimer le coût quand le fournisseur ne l'annonce pas.
#AC_OPENAI_TARIFS=openai/gpt-5=1.25/10
# Champs ajoutés tels quels au corps de chaque requête (options propres au fournisseur).
#AC_OPENAI_CORPS_EXTRA={}
AC_MODELE_DEFAUT=sonnet
# Plafond affiché dans Système : à régler sur le crédit mensuel réel du compte
AC_CREDIT_MENSUEL=20
# Délai maximal d'un tour, en secondes
AC_DELAI_TOUR=300

# Synchronisation (laisser vide pour désactiver une étape)
AC_GIT_REMOTE_RECETTES=git@github.com:UTILISATEUR/recettes.git
AC_GIT_REMOTE_AGENT=git@github.com:UTILISATEUR/aide-culinaire-agent.git
AC_RCLONE_DEST=gdrive:WORKSPACE/Recettes

# Mot de passe optionnel en plus du VPN (vide = pas de mot de passe)
AC_MOT_DE_PASSE=
